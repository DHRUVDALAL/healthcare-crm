# Production Environment Variables for Render / Cloud Deployment
PORT=10000
NODE_ENV=production
JWT_SECRET=super_secret_enterprise_jwt_key_change_in_production

# Option A: MySQL Connection Parameters (e.g. Aiven, PlanetScale, Railway, CleverCloud)
DB_HOST=your-mysql-host.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=recruitment_crm
DB_SSL=true

# Option B: Single Connection String URL
# DATABASE_URL=mysql://user:password@host:3306/recruitment_crm
